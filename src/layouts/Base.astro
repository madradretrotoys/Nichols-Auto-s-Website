---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {shop} from '../data/site';
interface Props {title:string; description:string;}
const {title,description}=Astro.props;
const path=Astro.url.pathname;
const live=import.meta.env.SITE_LIVE==='true';
const nav=[['Our shop','/about/'],['Services','/services/'],['Classic cars','/classic-cars/'],['Repair stories','/repair-stories/']];
const schema={'@context':'https://schema.org','@type':'AutoRepair',name:shop.name,url:'https://nicholsautorepair.net',telephone:shop.phone,address:{'@type':'PostalAddress',streetAddress:shop.street,addressLocality:'Wheat Ridge',addressRegion:'CO',postalCode:'80033',addressCountry:'US'},foundingDate:'1974'};
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{title} | Nichols Auto Repair</title><meta name="description" content={description}/>
 <meta name="theme-color" content="#20382e"/><meta name="robots" content={live?'index, follow':'noindex, nofollow'}/>
 <link rel="canonical" href={new URL(path,'https://nicholsautorepair.net')}/>
 <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
 <meta property="og:title" content={`${title} | Nichols Auto Repair`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(path,'https://nicholsautorepair.net')}/>
 <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
</head>
<body>
 <a class="skip-link" href="#main">Skip to content</a>
 <div class="topbar"><div class="wrap topbar-inner"><span>GOOD PEOPLE. HONEST WORK. <span class="topbar-extra">WHEAT RIDGE, COLORADO.</span></span><a href={shop.maps} target="_blank" rel="noopener noreferrer">5030 Kipling Street <Icon name="pin"/></a></div></div>
 <header class="site-header"><div class="wrap header-inner">
  <a href="/" class="brand original-brand" aria-label="Nichols Auto Repair home"><img src="/images/logo.png" alt="Nichols Automotive" width="345" height="244"/><span>WHEAT RIDGE · EST. 1974</span></a>
  <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">☰</span></button>
  <nav id="navigation" aria-label="Main navigation">{nav.map(([label,href])=><a class:list={{active:path.startsWith(href)}} aria-current={path.startsWith(href)?'page':undefined} href={href}>{label}</a>)}<a href="/contact/" class="button button-small">Let’s talk cars <Icon/></a></nav>
 </div></header>
 <main id="main"><slot/></main>
 <section class="closing"><div class="wrap closing-inner"><div><span class="eyebrow">YOUR NEXT MILE STARTS HERE</span><h2>Got a car question?<br/><em>You’ve got a neighbor.</em></h2></div><div><a class="button" href={shop.phoneHref}><Icon name="phone"/> {shop.phone}</a><a class="text-link" href="/contact/">Plan your visit <Icon/></a></div></div></section>
 <footer><div class="wrap footer-grid"><div><a href="/" class="brand footer-brand"><span class="brand-name">NICHOLS<span class="brand-dot">★</span></span><span class="brand-sub">AUTO REPAIR <span>EST. 1974</span></span></a><p>Keeping Wheat Ridge moving.<br/>One car. One conversation. One neighbor at a time.</p></div><div><h3>COME ON BY</h3><a href={shop.maps} target="_blank" rel="noopener noreferrer">{shop.street}<br/>{shop.city}</a><a href={shop.phoneHref}>{shop.phone}</a><p>Monday–Friday · 8:30 am–5:30 pm<br/>Call for Saturday availability.</p></div><div><h3>TAKE A LOOK AROUND</h3><a href="/services/">Our services</a><a href="/classic-cars/">Classic car care</a><a href="/repair-stories/">Repair stories & car care</a><a href="/reviews/">Customer reviews</a><a href="/contact/">Contact the shop</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Nichols Auto Repair. Built around our community.</span><a href="/privacy/">Privacy</a>{!live && <span class="preview-label">DESIGN PREVIEW</span>}</div></footer>
 <script>
  const button=document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav=document.querySelector<HTMLElement>('#navigation');
  button?.addEventListener('click',()=>{ const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open); });
  document.addEventListener('keydown',event=>{if(event.key==='Escape'){button?.setAttribute('aria-expanded','false');nav?.classList.remove('is-open');}});
 </script>
</body>
</html>
