---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import {services,shop} from '../../data/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
---
<Base title={`${service.title} in Wheat Ridge`} description={`${service.intro} Talk to Nichols Auto Repair in Wheat Ridge about ${service.title.toLowerCase()}.`}>
 <section class="page-intro wrap"><a class="breadcrumb" href="/services/">← All services</a><span class="eyebrow">NICHOLS AUTO REPAIR · WHEAT RIDGE, CO</span><h1>{service.title}</h1><p>{service.intro}</p></section>
 <section class="wrap detail-grid section-bottom"><div class="prose"><h2>Let’s get to<br/><em>the bottom of it.</em></h2><p>{service.body}</p><h3>What to look out for</h3><p>{service.signs}</p><h3>What happens next?</h3><p>Call us with your vehicle’s year, make, model, and the concern you are experiencing. We’ll discuss availability and the next step for an inspection or service.</p><a class="button" href="/contact/">Talk about your vehicle <Icon/></a></div><aside class="service-aside"><Icon name={service.icon}/><h3>Here to help with</h3><ul class="check-list">{service.items.map(item=><li><Icon name="check"/>{item}</li>)}</ul><hr/><p>Questions are always welcome.</p><a class="text-link" href={shop.phoneHref}>{shop.phone} <Icon name="phone"/></a></aside></section>
</Base>
