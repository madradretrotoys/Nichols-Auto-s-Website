---
import Base from '../../layouts/Base.astro';
import {guides} from '../../data/site';
export function getStaticPaths(){return guides.map(guide=>({params:{slug:guide.slug},props:{guide}}));}
const {guide}=Astro.props;
---
<Base title={guide.title} description={guide.description}><article class="wrap article"><a class="breadcrumb" href="/repair-stories/">← From the shop</a><span class="eyebrow">{guide.category} · CAR CARE GUIDE</span><h1>{guide.title}</h1><p class="article-lead">{guide.description}</p><div class="article-body">{guide.paragraphs.map(paragraph=><p>{paragraph}</p>)}<div class="note-panel"><h2>Let’s talk about your car.</h2><p>This guide is general information. Your vehicle’s owner’s manual and an inspection can help determine the right next step for your situation.</p><a class="text-link" href="/contact/">Contact Nichols Auto Repair →</a></div></div></article></Base>
